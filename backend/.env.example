# Database
MONGO_URI=mongodb://localhost:27017/makeusparkle

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Email Configuration (Gmail/SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# PhonePe (Payment Gateway)
PHONEPE_CLIENT_ID=your-phonepe-client-id
PHONEPE_CLIENT_SECRET=your-phonepe-client-secret
PHONEPE_CLIENT_VERSION=1

# Frontend URL (for email links and CORS)
FRONTEND_URL=http://localhost:3000

# Optional: comma-separated list of allowed origins for CORS (in addition to FRONTEND_URL)
# Example for prod + local:
# CORS_ORIGINS=https://make-us-sparkle.vercel.app,http://localhost:3000
CORS_ORIGINS=

# Server Port
PORT=5000
NODE_ENV=development

# ─── iThink Logistics ────────────────────────────────────────────────────────
# Staging (pre-alpha): https://pre-alpha.ithinklogistics.com/api_v3
# Production:          https://my.ithinklogistics.com/api_v3
ITL_BASE_URL=https://pre-alpha.ithinklogistics.com/api_v3
ITL_ACCESS_TOKEN=your-ithink-access-token
ITL_SECRET_KEY=your-ithink-secret-key
ITL_PICKUP_ADDRESS_ID=your-pickup-address-id

# Fallback shipping dimensions (used when a product has no dims set)
ITL_DEFAULT_WEIGHT_KG=0.5
ITL_DEFAULT_LENGTH_CM=10
ITL_DEFAULT_WIDTH_CM=10
ITL_DEFAULT_HEIGHT_CM=5

# Seller details for iThink shipment creation
ITL_SELLER_NAME=YourStoreName
ITL_SELLER_ADDRESS=
ITL_SELLER_CITY=
ITL_SELLER_STATE=
ITL_SELLER_PINCODE=
ITL_SELLER_PHONE=
